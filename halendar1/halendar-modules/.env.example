# Copier en .env puis remplir. NE JAMAIS COMMITER .env
# Ce sont les identifiants des comptes à connecter : sans eux, impossible
# de lire la boîte mail ou l'agenda de quelqu'un.

# ── Mail (lecture IMAP + envoi SMTP, même compte) ────────────────────────────
# Gmail : mot de passe d'application (myaccount.google.com/apppasswords)
MAIL_IMAP_HOST=imap.gmail.com:993
MAIL_USER=
MAIL_PASS=
# Optionnels : déduits automatiquement (smtp.gmail.com, port 587, expéditeur = MAIL_USER)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_FROM=
MAIL_DOSSIER=INBOX

# ── Agenda (CalDAV) ──────────────────────────────────────────────────────────
# iCloud : adresse du compte Apple + mot de passe d'application (account.apple.com)
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USER=
CALDAV_PASS=
# Optionnels
CALDAV_AGENDA=
CALDAV_FUSEAU=Europe/Paris
