PORT=4000
HOST_IP=0.0.0.0
USER=user
FRONTEND_URL=https://fronted.com
TRUSTED_ORIGINS="https://fronted.com"
ENV=dev

DATABASE_NAME=dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=superSecret
DB_PORT=5432

DB_DSN_DEV=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${DATABASE_NAME}?sslmode=disable
DB_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost/${DATABASE_NAME}
DB_MAX_OPEN_CONNECTIONS=50
DB_MAX_IDLE_CONNECTIONS=50
DB_MAX_IDLE_TIME=15m

REQUEST_PER_SECOND=10
BURST_LIMIT=8
RATE_LIMITER=TRUE
BODY_MAX_BYTE=1048576

SMTP_HOST=smtp.mail.thing
SMTP_PORT=587
SMTP_USERNAME=username
SMTP_PASSWORD=anotherSuperSecretPass
SMTP_SENDER="Team <no-reply@team.com>"

# User mailbox read/sent through the /v1/mail endpoints (an app password, not the account password)
MAIL_IMAP_HOST=imap.gmail.com:993
MAIL_IMAP_TLS=TRUE
MAIL_FOLDER=INBOX
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USER=user@gmail.com
MAIL_PASS=anAppPassword
MAIL_FROM="Halendar <user@gmail.com>"

# CalDAV calendar read/written through the /v1/calendar endpoints
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USER=user@icloud.com
CALDAV_PASS=anAppPassword
CALDAV_CALENDAR=
CALDAV_TIMEZONE=Europe/Paris

# Local LLM (docker-compose "ollama" service, not reachable outside the compose
# network). Pulled automatically on first start if not already in the volume.
# gemma3:1b is the lightest/fastest option; 4b/12b/27b trade download size and
# inference time for potentially better instruction-following. 1b's malformed-JSON
# problem turned out to be mostly a sampling issue (email analysis now calls Ollama
# with temperature 0 -- see GenerateDeterministic in internal/ollama) rather than a
# hard model-size limitation; a bigger model may still help with the date-arithmetic
# and false-positive cases documented on eventExtractionPromptTmpl, if revisited.
# OLLAMA_BASE_URL defaults to the in-network service address and normally
# doesn't need to be set; override it only when running the API outside compose.
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://ollama:11434

# Push notifications (Firebase Cloud Messaging). FCM_SERVICE_ACCOUNT_FILE is a path
# to the JSON key downloaded from Firebase Console > Project Settings > Service
# Accounts > Generate new private key. Without these, /v1/push/* endpoints return
# a clean "not configured" error rather than failing to start.
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_FILE=/app/firebase-service-account.json

# Encrypts connected email accounts' OAuth credentials at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 32
# Without it, connecting email accounts is disabled but everything else still runs.
ENCRYPTION_KEY=

# Google Cloud OAuth client, shared by "Connect Gmail" and "Connect Google Calendar"
# (Console > Google Auth Platform > Clients > OAuth client ID > Web application). Add
# BOTH redirect URLs below as authorized redirect URIs on that one client -- each must
# exactly match its value here. Without these, /v1/email-accounts/gmail/* and
# /v1/calendar-accounts/google/* return "unknown or unconfigured provider" instead of
# failing to start. Connecting Gmail also requests Calendar access and links a
# calendar account from the same grant -- GOOGLE_OAUTH_CALENDAR_REDIRECT_URL is only
# needed for connecting a Google Calendar on its own, without Gmail import.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://yourdomain.com/v1/email-accounts/gmail/callback
GOOGLE_OAUTH_CALENDAR_REDIRECT_URL=https://yourdomain.com/v1/calendar-accounts/google/callback

# How often connected accounts are checked for new mail.
EMAIL_SYNC_INTERVAL=1m
