# Copy to .env and fill it in. NEVER COMMIT .env
# These are the credentials for the accounts to connect to: without them,
# the mailbox or calendar can't be read.

# ── Mail (IMAP reading + SMTP sending, same account) ─────────────────────────
# Gmail: use an app password (myaccount.google.com/apppasswords)
MAIL_IMAP_HOST=imap.gmail.com:993
MAIL_USER=
MAIL_PASS=
# Optional: guessed automatically (smtp.gmail.com, port 587, sender = MAIL_USER)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_FROM=
MAIL_FOLDER=INBOX

# ── Calendar (CalDAV) ─────────────────────────────────────────────────────────
# iCloud: your Apple ID + an app-specific password (account.apple.com)
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USER=
CALDAV_PASS=
# Optional
CALDAV_CALENDAR=
CALDAV_TIMEZONE=Europe/Paris
